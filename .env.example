# Copy to .env for local development (.env is gitignored).
#
# jekyll-github-metadata uses this to authenticate against the Github API.
# Without it you get 60 requests/hour per IP, which a couple of local builds
# will exhaust - and the Github Projects section then renders empty.
#
# Create a fine-grained token with PUBLIC REPOSITORIES read access only:
#   https://github.com/settings/tokens
JEKYLL_GITHUB_TOKEN=
